# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model
CLAUDE_MODEL=claude-sonnet-5-5

# Password you type once per 30 days on your phone. Make it long.
APP_PASSWORD=

# Random string, 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Supabase: Project Settings -> API. Use the service_role key, never the anon key.
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
